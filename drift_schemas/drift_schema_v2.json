  "fixed_sql": [
    {
      "name": "anime",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"anime\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"uuid\" TEXT NOT NULL UNIQUE, \"title\" TEXT NOT NULL CHECK (length(trim(title)) BETWEEN 1 AND 200), \"original_title\" TEXT, \"season\" INTEGER CHECK (season > 0), \"entry_type\" TEXT CHECK (entry_type IN ('tv', 'movie', 'ova', 'ona', 'special')), \"source_provider\" TEXT, \"source_id\" TEXT, \"total_episodes\" INTEGER CHECK (total_episodes > 0), \"duration_minutes\" INTEGER CHECK (duration_minutes > 0), \"summary\" TEXT, \"cover_url\" TEXT, \"premiere_date\" TEXT, \"is_finished\" INTEGER, \"local_cover_path\" TEXT, \"status\" TEXT NOT NULL CHECK (status IN ('watching', 'completed', 'dropped', 'plan_to_watch')), \"progress\" INTEGER NOT NULL DEFAULT 0 CHECK (progress >= 0), \"score\" REAL CHECK (score >= 0 AND score <= 10), \"rewatch_count\" INTEGER CHECK (rewatch_count >= 2), \"tags\" TEXT NOT NULL DEFAULT '[]' CHECK (json_valid(tags) AND json_type(tags) = 'array'), \"notes\" TEXT, \"start_date\" TEXT, \"start_date_source\" TEXT CHECK (start_date_source IN ('manual', 'history')), \"end_date\" TEXT, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, CHECK((source_provider IS NULL AND source_id IS NULL)OR(length(trim(source_provider)) > 0 AND length(trim(source_id)) > 0 AND source_provider IS NOT NULL AND source_id IS NOT NULL)), CHECK(total_episodes IS NULL OR progress <= total_episodes), CHECK(status != 'plan_to_watch' OR progress = 0), CHECK(status != 'completed' OR total_episodes IS NULL OR progress = total_episodes), CHECK(status = 'completed' OR end_date IS NULL), CHECK(start_date IS NULL OR end_date IS NULL OR start_date <= end_date), CHECK(start_date IS NOT NULL OR start_date_source IS NULL));"
        }
      ]
    },
